# Configuration page  (admin/nutrition-settings-page.php)
# -----------------------------------------------
#: admin/nutrition-settings-page.php
msgid "Nutrition Labels - Configuration"
msgstr "Nährwertkennzeichnung – Konfiguration"

#: admin/nutrition-settings-page.php
msgid "QR Code Size"
msgstr "QR-Code-Größe"

#: admin/nutrition-settings-page.php
msgid ""
"Choose QR code size for download. Smaller sizes are better for small labels, "
"larger for posters."
msgstr ""
"QR-Code-Größe für den Download wählen. Kleinere Größen eignen sich besser "
"für kleine Etiketten, größere für Poster."

#: admin/nutrition-settings-page.php
msgid "Short Code Length"
msgstr "Kurzcode-Länge"

#: admin/nutrition-settings-page.php
msgid ""
"Length affects uniqueness vs readability. Shorter codes may conflict more "
"often."
msgstr ""
"Die Länge beeinflusst Einzigartigkeit vs. Lesbarkeit. Kürzere Codes können "
"häufiger kollidieren."

#: admin/nutrition-settings-page.php
msgid "Character Set"
msgstr "Zeichensatz"

#: admin/nutrition-settings-page.php
msgid "Current URL Format"
msgstr "Aktuelles URL-Format"

#: admin/nutrition-settings-page.php admin/nutrition-settings-page-simple.php
msgid "Information"
msgstr "Informationen"

