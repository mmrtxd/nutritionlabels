msgstr "¡Cambiar esto hará que los códigos QR existentes dejen de funcionar!"

#: admin/nutrition-settings-page-simple.php
msgid "Minimum is 4 characters. Shorter codes may conflict more often."
msgstr ""
"El mínimo es 4 caracteres. Los códigos más cortos pueden entrar en conflicto "
"con más frecuencia."

#: admin/nutrition-settings-page-simple.php
msgid "Choose allowed characters for short codes."
msgstr "Elija los caracteres permitidos para los códigos cortos."

